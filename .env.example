# CrewNest environment configuration
# Copy this file to .env and edit values as needed.
# IMPORTANT: .env is git-ignored. Never commit your real Neon credentials.

# --- Database ---
# Default: local SQLite database for a reproducible demo.
# Leave DATABASE_URL empty to use ./crewneat.db.
#
# Neon (recommended for the shared hackathon database):
# 1. Open your Neon project -> Connect.
# 2. Copy the POOLED connection string for normal app traffic.
# 3. Paste it into DATABASE_URL in your local .env file.
#
# Example shape only (do NOT put real credentials in this example file):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Optional direct/unpooled URL. Keep this for schema/admin work such as
# create_tables, migrations, pg_dump/pg_restore, etc.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Security ---
# Set a stable secret in .env so JWTs remain valid across restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server ---
# Port the app listens on. Defaults to 8001 to avoid HandyHire on 8000.
# PORT=8001
HOST=127.0.0.1

# --- Uploads ---
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
