# CrewNest environment configuration
# Copy this file to .env and edit values as needed.

# --- Database ---
# Default: local SQLite database for a reproducible demo (no external service).
# Leave DATABASE_URL unset (or empty) to use ./crewneat.db.
# For PostgreSQL later, set a real connection string, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/crewneat

# --- Security ---
# SECRET_KEY must be set in production. A dev default is generated below if absent.
# SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server ---
# Port the app listens on. Defaults to 8001 to avoid HandyHire on 8000.
# PORT=8001
HOST=127.0.0.1

# --- Uploads ---
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
